# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Local settings
.claude/settings.local.json

# Temporary files
*.tmp
*.bak
*.log

# Generated/regenerable artifacts
py/__pycache__/
*.pyc
data/*/workflow_status.json
data/*/search_log_agent_0.txt
data/jhu_conversion_summary.json
data/who_conversion_summary.json

# Large dashboard artifact (regenerated by update_dashboard.sh)
dashboard/weekly_surveillance_longform.csv

# Archive folder (local reference only)
archive/

# Tool-generated backups, locks and temp files (py/add_observation.py,
# py/repair_data_integrity.py). Never commit these - they are pre-write
# snapshots, not data.
.backup_*.csv
*.csv.lock
.*.lock
*.csv.resolved

# Union files written by py/combine_all_sources.py. They duplicate the three
# canonical per-source files and have caused double-counting when globbed.
data/*/cholera_data.csv
data/*/metadata.csv

# Graceful-halt sentinel for run_all_countries.sh. Must never be tracked:
# a committed STOP is restored by any checkout and silently halts an
# unattended run after one country.
STOP
reference/.runner.pid

reference/.heartbeat.pid
reference/.git_publish.lock
reference/.*.lock
